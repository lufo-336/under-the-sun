# Copia in .env (cp .env.example .env). .env non si committa mai.
POSTGRES_USER=uts
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=underthesun
DB_PORT=5433

# Per backend e batch avviati FUORI da Docker
DATABASE_URL=postgres://uts:cambiami@localhost:5433/underthesun

# Backend: chiave per firmare i token di login. In locale va bene questa,
# per la demo mettetene una lunga e casuale.
JWT_SECRET=cambiami-anche-questo
BACKEND_PORT=3000
# Password degli account di prova creati da `npm run crea-utenti`
PASSWORD_PROVA=prova1234

# esempi = campione del SAL 1, giugno 2026 (nel repo). output = dataset completo.
CARTELLA_CSV=esempi
