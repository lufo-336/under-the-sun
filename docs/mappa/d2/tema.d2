# Tema condiviso per tutti i diagrammi D2 di UnderTheSun (ELK 90°, tema scuro ardesia)
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
    pad: 32
    theme-overrides: {
      N1: "#E2E8F0"
      N2: "#CBD5E1"
      N3: "#94A3B8"
      N4: "#64748B"
      N5: "#334155"
      N6: "#1E293B"
      N7: "#0F172A"
      B1: "#94A3B8"
      B2: "#7DD3FC"
      B3: "#38BDF8"
      B4: "#1E293B"
      B5: "#172033"
      B6: "#111A2B"
    }
  }
}

classes: {
  fatto: {
    style: {
      fill: "#0E2A1E"
      stroke: "#34D399"
      stroke-width: 2
      border-radius: 10
      font-color: "#D1FAE5"
    }
  }
  revisione: {
    style: {
      fill: "#0C2538"
      stroke: "#38BDF8"
      stroke-width: 2
      border-radius: 10
      font-color: "#E0F2FE"
    }
  }
  sprint1: {
    style: {
      fill: "#2A1F0A"
      stroke: "#FBBF24"
      stroke-width: 2
      stroke-dash: 5
      border-radius: 10
      font-color: "#FEF3C7"
    }
  }
  sprint2: {
    style: {
      fill: "#1E293B"
      stroke: "#64748B"
      stroke-width: 2
      stroke-dash: 5
      border-radius: 10
      font-color: "#CBD5E1"
    }
  }
  esterno: {
    style: {
      fill: "#2A160B"
      stroke: "#FB923C"
      stroke-width: 2
      border-radius: 10
      font-color: "#FFEDD5"
    }
  }
  area: {
    style: {
      fill: "#111A2B"
      stroke: "#334155"
      stroke-width: 2
      border-radius: 14
      font-color: "#F1F5F9"
      font-size: 16
      bold: true
    }
  }
  sottoarea: {
    style: {
      fill: "#172033"
      stroke: "#334155"
      stroke-width: 1
      border-radius: 10
      font-color: "#CBD5E1"
      font-size: 14
      bold: true
    }
  }
  attore: {
    shape: person
    style: {
      fill: "#1E293B"
      stroke: "#94A3B8"
      stroke-width: 2
      font-color: "#E2E8F0"
    }
  }
  f-fatto: {
    style: {
      stroke: "#34D399"
      stroke-width: 2
      font-color: "#A7F3D0"
    }
  }
  f-revisione: {
    style: {
      stroke: "#38BDF8"
      stroke-width: 2
      font-color: "#BAE6FD"
    }
  }
  f-sprint1: {
    style: {
      stroke: "#FBBF24"
      stroke-width: 2
      stroke-dash: 5
      font-color: "#FDE68A"
    }
  }
  f-sprint2: {
    style: {
      stroke: "#64748B"
      stroke-width: 2
      stroke-dash: 5
      font-color: "#94A3B8"
    }
  }
  f-neutra: {
    style: {
      stroke: "#94A3B8"
      stroke-width: 2
      font-color: "#CBD5E1"
    }
  }
  invisibile: {
    style.opacity: 0
  }
}
