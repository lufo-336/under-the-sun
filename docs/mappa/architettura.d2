# UnderTheSun — mappa interattiva dell'architettura (D2 v0.9)
#
# Compilazione (da questa cartella): ./compila.sh
#   lancia d2 --scale 1 e poi rende scuro anche lo sfondo della finestra del browser.
# Anteprima live mentre si scrive: d2 --watch architettura.d2 out/index.svg
#
# Convenzioni:
# - motore ELK: solo linee dritte e angoli a 90 gradi; sviluppo verticale;
# - stato di ogni pezzo con le classi qui sotto (fatto / revisione / sprint1 / sprint2 / esterno);
# - etichette sempre tra virgolette: in D2 il carattere # apre un commento;
# - blocchi di testo e codice con delimitatore ||| (il codice contiene spesso | e ||).
# - larghezza di ogni pagina sotto ~1850 px (con SCALA 0.85 entra in 1600 px): meglio
#   sezioni una sotto l'altra e testi a capo che righe lunghe di riquadri.
# Ogni pagina di dettaglio (layers) ha: navigazione, titolo, schema, scelte con il perché, codice reale.
#
# Trappole già incontrate (D2 0.9 + ELK):
# - ELK ignora "direction" dentro i contenitori: per mettere riquadri in fila usare
#   grid-rows/grid-columns (grid-rows scritto PRIMA, così la griglia si riempie per righe);
# - una freccia che entra in un riquadro DENTRO una griglia viene disegnata in diagonale:
#   griglie solo dove le frecce esterne arrivano al contenitore;
# - "a <- b" fa mettere b SOTTO a (la freccia punta comunque verso a);
# - D2 non manda a capo il markdown: le righe lunghe finiscono con \ (a capo forzato);
# - $ nelle etichette tra "..." va scritto \$ (altrimenti D2 cerca una variabile);
#   nei blocchi ||| invece non serve;
# - un link a un'altra pagina da dentro una pagina si scrive _.layers.nome (layers.nome non funziona).

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
    pad: 60
    # Tema scuro "ardesia": sfondo, testi e bordi predefiniti.
    theme-overrides: {
      N1: "#E2E8F0"
      N2: "#CBD5E1"
      N3: "#94A3B8"
      N4: "#64748B"
      N5: "#334155"
      N6: "#1E293B"
      N7: "#0B1220"
      B1: "#94A3B8"
      B2: "#7DD3FC"
      B3: "#38BDF8"
      B4: "#1E293B"
      B5: "#172033"
      B6: "#111A2B"
    }
  }
}

classes: {
  # --- stato dei pezzi (stessi colori in tutte le pagine) ---
  fatto: {
    style: {
      fill: "#0E2A1E"
      stroke: "#34D399"
      stroke-width: 2
      border-radius: 8
      font-color: "#D1FAE5"
    }
  }
  revisione: {
    style: {
      fill: "#0B2433"
      stroke: "#38BDF8"
      stroke-width: 2
      border-radius: 8
      font-color: "#E0F2FE"
    }
  }
  sprint1: {
    style: {
      fill: "#2E2309"
      stroke: "#FBBF24"
      stroke-width: 2
      stroke-dash: 5
      border-radius: 8
      font-color: "#FEF3C7"
    }
  }
  sprint2: {
    style: {
      fill: "#141C2B"
      stroke: "#64748B"
      stroke-width: 2
      stroke-dash: 5
      border-radius: 8
      font-color: "#94A3B8"
    }
  }
  esterno: {
    style: {
      fill: "#2A1A0E"
      stroke: "#FB923C"
      stroke-width: 2
      font-color: "#FFEDD5"
    }
  }

  # --- contenitori, schede e navigazione ---
  area: {
    style: {
      fill: "#0F172A"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 14
      font-color: "#F1F5F9"
      font-size: 22
      bold: true
    }
  }
  sottoarea: {
    style: {
      fill: "#131D31"
      stroke: "#334155"
      border-radius: 10
      font-color: "#CBD5E1"
      font-size: 18
      bold: true
    }
  }
  scheda: {
    label.near: top-left
    style: {
      fill: "#111A2B"
      stroke: "#334155"
      border-radius: 10
      font-color: "#93C5FD"
      font-size: 17
      bold: true
    }
  }
  griglia: {
    label: ""
    style: {
      fill: transparent
      stroke: transparent
    }
  }
  torna: {
    style: {
      fill: "#1E293B"
      stroke: "#94A3B8"
      border-radius: 18
      font-color: "#F8FAFC"
      bold: true
    }
  }
  vai: {
    style: {
      fill: "#0C2340"
      stroke: "#60A5FA"
      border-radius: 18
      font-color: "#BFDBFE"
    }
  }
  invisibile: {
    style.opacity: 0
  }

  # --- frecce ---
  f-fatto: {
    style: {
      stroke: "#34D399"
      stroke-width: 2
      font-color: "#A7F3D0"
    }
  }
  f-revisione: {
    style: {
      stroke: "#38BDF8"
      stroke-width: 2
      font-color: "#BAE6FD"
    }
  }
  f-sprint1: {
    style: {
      stroke: "#FBBF24"
      stroke-width: 2
      stroke-dash: 5
      font-color: "#FDE68A"
    }
  }
  f-sprint2: {
    style: {
      stroke: "#64748B"
      stroke-width: 2
      stroke-dash: 5
      font-color: "#94A3B8"
    }
  }
  f-neutra: {
    style: {
      stroke: "#94A3B8"
      stroke-width: 2
      font-color: "#CBD5E1"
    }
  }
}

# ==============================================================================
# VISTA GENERALE
# ==============================================================================
grid-columns: 1
grid-gap: 44

titolo: |||md
  # UnderTheSun — mappa dell'architettura

  Portale della **Comunità Energetica Rinnovabile Buby Green** · team **PlusUltra** · stato al **lunedì 23 novembre 2026** (SAL 1 fatto, Sprint 1 appena iniziato)

  **In breve**
  - su `main` sono già uniti database (#6), campione dati giugno 2026 (#8), backend JWT (#9) e mappa D2 (#21)
  - chiuse le PR superate (#4, #7); restano in revisione #10 (CI), #5 (wireframe + restyling) e #23 (login JWT)
  - 10 Issue aperte (#11–#20) per arrivare al SAL 2 di venerdì 4 dicembre (mini SAL col cliente ven 27 nov)

  **Come si usa:** clicca un riquadro con l'icona del link per aprire la sua pagina di dettaglio (schema, scelte, codice reale, storico GitHub).\
  Sui riquadri con la "i" passa il mouse per una nota veloce. Ctrl + e Ctrl − del browser ingrandiscono e rimpiccioliscono.
|||

calendario: "Dove siamo nel calendario" {
  class: area
  label.near: top-left   # al centro finirebbe sotto l'icona del link di "Sprint 1"
  grid-rows: 2
  grid-columns: 4
  grid-gap: 20

  s0: "1 · Sprint 0 · fondamenta\n12 → 20 nov\nDB, backend, dati, wireframe, CI" {class: fatto}
  sal1: "2 · SAL 1 · lun 23 nov\nschema dati e contratto API\ncongelati" {class: fatto}
  s1: "3 · Sprint 1 · in corso\n23 nov → ven 4 dic\nprimo percorso completo" {
    class: sprint1
    link: layers.sprint1
    tooltip: "Clicca per il piano dello Sprint 1: le 10 Issue, chi le fa e in che ordine"
  }
  mini: "4 · Mini SAL col cliente\nven 27 nov\nstato + 3-4 domande puntuali" {class: sprint1}
  sal2: "5 · SAL 2 · ven 4 dic\ndataset completo, modelli,\nclassificazione testi" {class: sprint2}
  s2: "6 · Sprint 2 · 4 → 14 dic\ntutto collegato" {class: sprint2}
  fin: "7 · SAL finale col cliente\nven 18 dic" {class: sprint2}
  gen: "8 · Gennaio 2027\nrifiniture e\npresentazione finale" {class: sprint2}
}

legenda: "Legenda · cosa è fatto e cosa manca" {
  class: area
  grid-rows: 1
  grid-columns: 6
  grid-gap: 20

  l1: "Fatto · su main\nPR approvata, provata\ne unita su main" {class: fatto}
  l2: "Fatto, in revisione\nPR aperta, manca\nl'Approve" {class: revisione}
  l3: "Da fare · Sprint 1\n23 nov → 4 dic" {class: sprint1}
  l4: "Previsto · Sprint 2\n4 → 14 dic" {class: sprint2}
  l5: "Servizio esterno\n(fuori dal nostro codice)" {
    class: esterno
    shape: cloud
  }
  l6: |||md
    **Frecce**
    - piena verde: funziona già
    - piena azzurra: in revisione
    - gialla tratteggiata: arriva nello Sprint 1
    - grigia tratteggiata: Sprint 2
  |||
}

mappa: "Architettura · chi parla con chi" {
  class: area
  direction: down

  utenti: "Utenti del portale · 3 ruoli (minimizzazione GDPR)" {
    class: sottoarea
    direction: right

    socio: "Socio della CER\nfamiglia · impresa · ente\nvede solo i propri dati (/api/me/*)" {
      shape: person
      style.fill: "#1E293B"
      style.stroke: "#94A3B8"
    }
    operatore: "Operatore Buby Green\nimpianti, anomalie, segnalazioni\nconsumi solo aggregati" {
      shape: person
      style.fill: "#1E293B"
      style.stroke: "#94A3B8"
    }
    admin: "Admin della CER\nKPI della comunità, soci, verbali\naccesso completo" {
      shape: person
      style.fill: "#1E293B"
      style.stroke: "#94A3B8"
    }
  }

  compose: "Docker Compose · un solo comando avvia tutto (US-13)" {
    class: sottoarea
    icon: https://icons.terrastruct.com/dev%2Fdocker.svg
    direction: down

    frontend: "Frontend · React 19 + Vite 8 + Tailwind 4 + Recharts 3" {
      class: sottoarea
      icon: https://icons.terrastruct.com/dev%2Freact.svg
      link: layers.frontend
      # griglia: ordine fisso da sinistra (fatto) a destra (Sprint 2).
      # Si può usare solo dove le frecce esterne arrivano al contenitore, non ai riquadri.
      grid-rows: 1
      grid-columns: 3
      grid-gap: 20

      wire: "Wireframe 8 viste + restyling\nPR #5 (d5c537e) e login JWT\nPR #23 (in revisione)\n#4 e #7 chiuse" {
        class: revisione
        link: layers.frontend
        tooltip: "Le forme dei dati finti ricalcano docs/api.md: quando arrivano le API vere i componenti non cambiano."
      }
      s1: "Sprint 1 · Mirko\nreview #5 (#12) e #23 (#13)\ndashboard socio (#15)\nsegnalazioni (#17)" {
        class: sprint1
        link: layers.frontend
      }
      s2: "Sprint 2\nsimulatore, pagine\noperatore e admin" {
        class: sprint2
        link: layers.frontend
      }
    }

    backend: "Backend · Node 22 + Express 5 + pg" {
      class: sottoarea
      link: layers.backend
      grid-rows: 1
      grid-columns: 3
      grid-gap: 20

      fatto: "PR #9 unita su main · 7 test\nlogin JWT HS256\nruoli controllati dal server\n/api/salute · /api/auth/*\n/api/impianti" {
        class: fatto
        link: layers.backend
        tooltip: "creaApp({ db, config }): i test passano un database finto, così npm test gira senza Postgres."
      }
      s1: "Sprint 1 · Stefano\n/api/me/riepilogo (#14)\n/api/me/consumi (#14)\n/api/me/segnalazioni\n+ LLM (#16)" {
        class: sprint1
        link: layers.backend
      }
      s2: "Sprint 2\nsimulazione · anomalie\ncoda operatore\ncomunità · soci · verbali" {
        class: sprint2
        link: layers.backend
      }
    }

    db: "Database · PostgreSQL 17 + dbmate 2.38.1" {
      class: sottoarea
      icon: https://icons.terrastruct.com/dev%2Fpostgresql.svg
      link: layers.database
      direction: right

      schema: "14 tabelle con vincoli\nore in UTC · migrate + seed\n13 CSV in una transazione\nPR #6 unita su main" {
        class: fatto
        shape: cylinder
        link: layers.database
        tooltip: "Schema congelato al SAL 1: da qui ogni cambiamento è una migrazione nuova in db/migrations/."
      }
      s1: "Sprint 1\ncaricare il dataset di 2 anni\nCARTELLA_CSV=output (#18)" {
        class: sprint1
        link: layers.database
      }
    }

    frontend -> backend: "HTTP JSON su /api + Authorization: Bearer <JWT>\nSprint 1 (#13): oggi le pagine leggono i dati finti" {class: f-sprint1}
    backend -> db: "SQL con pg.Pool · query parametrizzate (\$1)\nNUMERIC → number JSON" {class: f-fatto}
  }

  llm: "LLM via API · piano gratuito\nclassifica le segnalazioni (Sprint 1)\nriassume i verbali (Sprint 2-3)" {
    class: esterno
    shape: cloud
    link: layers.flusso_llm
    tooltip: "Clicca per il percorso completo di una segnalazione, con il caso 'LLM non risponde'."
  }

  dati: "Pipeline dati · Python (Francesco, Giuseppe, Cecilia)" {
    class: sottoarea
    icon: https://icons.terrastruct.com/dev%2Fpython.svg
    link: layers.dati
    direction: right

    fonti: "Fonti reali\nOpen-Meteo · PVGIS · ARERA · ISPRA · GSE" {
      class: esterno
      shape: cloud
    }
    campione: "genera.py + controlli.py (123 su 123 ok)\ncampione giugno 2026: 3 impianti, 20 soci\nPR #8 unita su main" {
      class: fatto
      link: layers.dati
      tooltip: "Seed fisso 42: due rilanci producono file identici bit per bit."
    }
    completo: "Sprint 1 · dataset completo (#18)\nnov 2024 → ott 2026\n8 impianti · 240 soci · 17.520 ore" {
      class: sprint1
      link: layers.dati
    }
    nlp: "Sprint 1 · 200-300 segnalazioni etichettate\nprompt LLM · primi modelli\nformule CER e simulatore (#19)" {
      class: sprint1
      link: layers.dati
    }
    batch: "Sprint 2 · batch offline (US-11)\nprevisioni · anomalie\nripartizione mensile" {
      class: sprint2
      link: layers.dati
    }

    fonti -> campione: "scaricate una volta,\npoi cache" {class: f-neutra}
    campione -> completo: "stesso codice,\nconfig completa" {class: f-sprint1}
    campione -> nlp: "stesse anomalie" {class: f-sprint1}
  }

  ci: "GitHub · CI, storico e processo di lavoro" {
    class: sottoarea
    link: layers.devops
    grid-rows: 2
    grid-columns: 2
    grid-gap: 16

    actions: "GitHub Actions · 3 job\ntest backend · build frontend\nCompose + seed + /api/salute\nPR #10 · 3/3 verdi · manca Approve" {
      class: revisione
      link: layers.devops
    }
    s1: "Sprint 1\n#6, #8, #9 su main · resta #10\ncheck obbligatori (#11)\nfrontend in Compose (#20)" {
      class: sprint1
      link: layers.devops
    }
    storico: "Storico GitHub · PR e review\n8 PR unite · 3 aperte · 2 chiuse\n10 Issue Sprint 1 (#11–#20)" {
      class: fatto
      link: layers.storico
      tooltip: "Clicca per lo storico completo del repository con i link a tutte le PR e alle review."
    }
    s1_link: "Piano Sprint 1 · dipendenze\nle 10 Issue in ordine (#11–#20)" {
      class: sprint1
      link: layers.sprint1
      tooltip: "Clicca per il piano dettagliato dello Sprint 1."
    }
  }

  # Le frecce scritte con <- puntano verso l'alto: così ELK mette i dati e la CI
  # sotto la piattaforma invece che sopra.
  utenti -> compose.frontend: "browser" {class: f-neutra}
  compose.backend -> llm: "testo della segnalazione · chiave solo nel backend\nse l'LLM non risponde: 201 comunque (#16)" {class: f-sprint1}
  compose.db.schema <- dati.campione: "13 CSV · seed con HEADER match" {class: f-fatto}
  compose.db.s1 <- dati.completo: "CSV completi da data/output" {class: f-sprint1}
  llm <- dati.nlp: "prompt · 6 categorie · 3 urgenze" {class: f-sprint1}
  compose.db <-> dati.batch: "legge le serie · scrive i risultati" {class: f-sprint2}
  ci -> compose: "a ogni PR: costruisce\ne prova lo stack" {class: f-revisione}
}

scelte: "Le scelte che reggono l'architettura (e perché)" {
  class: area
  grid-rows: 2
  grid-columns: 3
  grid-gap: 20

  c1: "1 · Il database è il punto d'incontro" {
    class: scheda
    m: |||md
      Frontend e pipeline Python **non si parlano mai**: si\
      incontrano nelle 14 tabelle. Lo schema SQL e `docs/api.md`,\
      congelati al SAL 1, sono il contratto tra WSA e team dati.

      **Perché:** due gruppi con competenze diverse lavorano in\
      parallelo senza aspettarsi; se una parte cambia, la CI (job\
      *integrazione*) se ne accorge subito.
    |||
  }
  c2: "2 · Niente calcoli pesanti al clic" {
    class: scheda
    m: |||md
      Previsioni, anomalie e ripartizione dell'incentivo le\
      calcolano **batch Python offline** e le salvano nel DB. Al\
      volo si fanno solo il simulatore e la classificazione di una\
      nuova segnalazione.

      **Perché:** pagine veloci, Python resta separato da Node, e\
      i modelli si possono rifare senza toccare il backend.
    |||
  }
  c3: "3 · Tempo sempre in UTC" {
    class: scheda
    m: |||md
      Colonne `timestamptz`, contenitori con `TZ=UTC`, API in ISO\
      8601 con la `Z`. Solo il browser converte in ora italiana\
      (`Europe/Rome`).

      **Perché:** col cambio dell'ora legale un giorno può avere\
      23 o 25 ore: in UTC le serie orarie non hanno buchi né\
      doppioni.
    |||
  }
  c4: "4 · Permessi decisi dal server" {
    class: scheda
    m: |||md
      Il token JWT porta solo `ruolo` e `socio_id`. Nell'area\
      socio il backend usa **sempre** il `socio_id` del token, mai\
      un id mandato dal browser. L'operatore vede i consumi solo\
      aggregati.

      **Perché:** il frontend si può manomettere, il server no; e\
      il GDPR chiede di mostrare solo i dati necessari.
    |||
  }
  c5: "5 · L'LLM aiuta ma non blocca" {
    class: scheda
    m: |||md
      La chiave dell'LLM vive solo nel `.env` del backend. Se il\
      servizio gratuito è lento o finisce la quota, la\
      segnalazione si salva lo stesso (`201`) e l'operatore la\
      classifica a mano.

      **Perché:** una segnalazione persa è peggio di una non\
      classificata. Le colonne `*_llm` non si sovrascrivono mai:\
      servono a misurare l'accuratezza (US-12).
    |||
  }
  c6: "6 · Riproducibile su ogni PC" {
    class: scheda
    m: |||md
      Docker Compose (Docker Desktop su Windows, Podman su\
      Fedora), dati generati da script con **seed fisso**. Nel\
      repo vanno solo gli script e il campione di giugno, mai il\
      dataset completo.

      **Perché:** chiunque del team rigenera gli stessi file e lo\
      stesso database con due comandi, e il repo resta leggero.
    |||
  }
}

# ==============================================================================
# PAGINE DI DETTAGLIO
# ==============================================================================
layers: {

  # ----------------------------------------------------------------------------
  # DATABASE
  # ----------------------------------------------------------------------------
  database: {
    grid-columns: 1
    grid-gap: 40

    nav: "" {
      class: griglia
      grid-rows: 1
      grid-gap: 16
      torna: "← Vista generale" {class: torna; link: _}
      pr6: "PR #6 · database in Docker" {class: vai; link: https://github.com/lufo-336/under-the-sun/pull/6}
      i11: "Issue #11 · merge e CI" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/11}
      i18: "Issue #18 · dataset di 2 anni" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/18}
    }

    titolo: |||md
      # Database · PostgreSQL 17 + dbmate
      **Stato:** **unita su `main`** (PR #6 di Luca, provata da Stefano su Docker Desktop/Windows e da Luca su Podman/Fedora). Lo schema è\
      **congelato al SAL 1**: da qui ogni modifica è una migrazione nuova.\
      **Sprint 1:** caricare il dataset completo di 2 anni con `CARTELLA_CSV=output` (Issue #18).
    |||

    modello: "Modello dati · 14 tabelle, colorate per chi le scrive" {
      class: area
      direction: right

      anag: "Anagrafiche · CSV del team dati" {
        class: sottoarea
        direction: down
        socio: {
          shape: sql_table
          style.fill: "#5B21B6"
          style.font-color: "#F5F3FF"
          id: integer {constraint: primary_key}
          nome: text
          tipo: "text · famiglia | impresa | ente"
          comune: text
          data_adesione: date
        }
        impianto: {
          shape: sql_table
          style.fill: "#5B21B6"
          style.font-color: "#F5F3FF"
          id: integer {constraint: primary_key}
          nome: text
          comune: text
          lat: "double precision"
          lon: "double precision"
          kwp: "double · CHECK > 0"
          inclinazione_gradi: "double · 0..90"
          azimut_gradi: "double · -180..180 (0 = sud)"
          data_attivazione: date
        }
        parametro: {
          shape: sql_table
          style.fill: "#5B21B6"
          style.font-color: "#F5F3FF"
          chiave: text {constraint: primary_key}
          valore: "double precision"
          fonte: text
        }
        verbale: {
          shape: sql_table
          style.fill: "#5B21B6"
          style.font-color: "#F5F3FF"
          id: integer {constraint: primary_key}
          data_assemblea: date
          testo: text
          sintesi: "text · dall'LLM"
        }
      }

      accesso: "Accesso · lo scrive il backend" {
        class: sottoarea
        utente: {
          shape: sql_table
          style.fill: "#1D4ED8"
          style.font-color: "#EFF6FF"
          id: "integer identity" {constraint: primary_key}
          email: text {constraint: unique}
          password_hash: "text · bcrypt"
          ruolo: "text · socio | operatore | admin"
          socio_id: integer {constraint: [foreign_key; unique]}
        }
      }

      serie: "Serie orarie e bollette · CSV del team dati" {
        class: sottoarea
        direction: down
        produzione_oraria: {
          shape: sql_table
          style.fill: "#6D28D9"
          style.font-color: "#F5F3FF"
          impianto_id: integer {constraint: [primary_key; foreign_key]}
          ts: "timestamptz (UTC)" {constraint: primary_key}
          kwh: "double · >= 0"
        }
        meteo_orario: {
          shape: sql_table
          style.fill: "#6D28D9"
          style.font-color: "#F5F3FF"
          impianto_id: integer {constraint: [primary_key; foreign_key]}
          ts: "timestamptz (UTC)" {constraint: primary_key}
          irraggiamento_wm2: "double · orizzontale"
          irraggiamento_pannelli_wm2: "double · piano moduli"
          temperatura_c: double
          nuvolosita_pct: "double · 0..100"
          neve_cm: "double · >= 0"
        }
        consumo_orario: {
          shape: sql_table
          style.fill: "#6D28D9"
          style.font-color: "#F5F3FF"
          socio_id: integer {constraint: [primary_key; foreign_key]}
          ts: "timestamptz (UTC)" {constraint: primary_key}
          kwh: "double · >= 0"
        }
        bolletta: {
          shape: sql_table
          style.fill: "#6D28D9"
          style.font-color: "#F5F3FF"
          id: integer {constraint: primary_key}
          socio_id: integer {constraint: foreign_key}
          mese: "date · sempre il giorno 1"
          kwh: double
          importo_eur: "numeric(10,2)"
        }
      }

      derivate: "Derivate · oggi valori provvisori del campione, dallo Sprint 2 le scrive il batch" {
        class: sottoarea
        direction: down
        previsione_produzione: {
          shape: sql_table
          style.fill: "#475569"
          style.font-color: "#F8FAFC"
          impianto_id: integer {constraint: [primary_key; foreign_key]}
          ts: timestamptz {constraint: primary_key}
          kwh_previsti: "double · >= 0"
        }
        previsione_consumo: {
          shape: sql_table
          style.fill: "#475569"
          style.font-color: "#F8FAFC"
          socio_id: integer {constraint: [primary_key; foreign_key]}
          ts: timestamptz {constraint: primary_key}
          kwh_previsti: "double · >= 0"
        }
        ripartizione_mensile: {
          shape: sql_table
          style.fill: "#475569"
          style.font-color: "#F8FAFC"
          socio_id: integer {constraint: [primary_key; foreign_key]}
          mese: date {constraint: primary_key}
          kwh_condivisi: double
          incentivo_eur: "numeric(10,2)"
          co2_evitata_kg: double
        }
        anomalia: {
          shape: sql_table
          style.fill: "#475569"
          style.font-color: "#F8FAFC"
          id: "integer identity" {constraint: primary_key}
          impianto_id: integer {constraint: foreign_key}
          inizio: timestamptz
          fine: "timestamptz · >= inizio"
          tipo: "guasto | sporcizia | stringa | neve"
          score: "double · 0..1"
          stato: "aperta | chiusa · la chiude l'operatore"
        }
      }

      segn: "Segnalazioni · CSV + backend (Sprint 1) + operatore" {
        class: sottoarea
        segnalazione: {
          shape: sql_table
          style.fill: "#B45309"
          style.font-color: "#FFFBEB"
          id: "integer identity" {constraint: primary_key}
          socio_id: "integer · null se interna" {constraint: foreign_key}
          impianto_id: "integer · in uso" {constraint: foreign_key}
          impianto_id_llm: "integer · mai modificato" {constraint: foreign_key}
          ts: "timestamptz default now()"
          canale: "email | portale | interno"
          testo: text
          categoria_llm: "text · mai modificata"
          urgenza_llm: "text · mai modificata"
          categoria: "text · correggibile"
          urgenza: "alta | media | bassa"
          stato: "aperta | in_corso | chiusa"
        }
      }

      accesso.utente.socio_id -> anag.socio.id {class: f-neutra}
      serie.consumo_orario.socio_id -> anag.socio.id {class: f-neutra}
      serie.bolletta.socio_id -> anag.socio.id {class: f-neutra}
      serie.produzione_oraria.impianto_id -> anag.impianto.id {class: f-neutra}
      serie.meteo_orario.impianto_id -> anag.impianto.id {class: f-neutra}
      derivate.previsione_produzione.impianto_id -> anag.impianto.id {class: f-neutra}
      derivate.previsione_consumo.socio_id -> anag.socio.id {class: f-neutra}
      derivate.ripartizione_mensile.socio_id -> anag.socio.id {class: f-neutra}
      derivate.anomalia.impianto_id -> anag.impianto.id {class: f-neutra}
      segn.segnalazione.socio_id -> anag.socio.id {class: f-neutra}
      segn.segnalazione.impianto_id -> anag.impianto.id {class: f-neutra}
      segn.segnalazione.impianto_id_llm -> anag.impianto.id {class: f-neutra}
    }

    avvio: "Avvio in Docker Compose · l'ordine lo garantiscono healthcheck e depends_on" {
      class: area
      direction: down

      db: "db · postgres:17\n127.0.0.1:5433 · volume dati-db · TZ=UTC\nhealthcheck: pg_isready ogni 5 s" {
        class: fatto
        shape: cylinder
      }
      migrate: "migrate · dbmate 2.38.1\napplica solo le migrazioni nuove\npoi si spegne (exit 0)" {class: fatto}
      seed: "seed · a richiesta (profilo strumenti)\n13 CSV con \\copy · HEADER match\ntutto in una transazione + setval" {class: fatto}
      backend: "backend\nparte solo dopo migrate\ncrea-utenti: account di prova con bcrypt" {class: fatto}
      completo: "Sprint 1 (#18)\nCARTELLA_CSV=output docker compose run --rm seed\ncarica i 2 anni generati in locale" {class: sprint1}

      db -> migrate: "1 · service_healthy" {class: f-fatto}
      migrate -> seed: "2 · service_completed_successfully" {class: f-fatto}
      migrate -> backend: "2 · service_completed_successfully" {class: f-fatto}
      seed -> completo: "stesso comando, altra cartella" {class: f-sprint1}
    }

    scelte: "Scelte architetturali e perché" {
      class: area
      grid-rows: 2
      grid-columns: 3
      grid-gap: 20

      a: "Vincoli nel database, non solo nel codice" {
        class: scheda
        m: |||md
          `CHECK` su ruoli, categorie, urgenze, canali, stati, `score`\
          tra 0 e 1, `kwp > 0`, `mese` sempre il giorno 1; chiavi\
          esterne ovunque. **Perché:** i dati arrivano da due strade\
          (CSV di Python e API di Node). Un solo guardiano nel DB\
          ferma gli errori di entrambe.
        |||
      }
      b: "Migrazioni versionate con dbmate" {
        class: scheda
        m: |||md
          Un file SQL con `-- migrate:up` e `-- migrate:down`; il\
          servizio `migrate` applica solo quelli nuovi. **Perché:** è\
          SQL puro (il team dati lo legge), funziona uguale in locale\
          e in CI, e non lega lo schema a una libreria di Node.
        |||
      }
      c: "Caricamento che fallisce subito" {
        class: scheda
        m: |||md
          `\copy ... WITH (FORMAT csv, HEADER match)` dentro\
          `--single-transaction`: se un CSV ha una colonna in più, in\
          meno o in un altro ordine, si ferma e non lascia dati a\
          metà. **Perché:** è il controllo automatico del contratto\
          tra team dati e WSA.
        |||
      }
      d: "Valori dell'LLM separati da quelli in uso" {
        class: scheda
        m: |||md
          In `segnalazione` ci sono `categoria_llm` e `categoria`\
          (idem urgenza e impianto). L'operatore corregge solo i\
          valori in uso. **Perché:** il confronto tra le due colonne\
          dà l'accuratezza reale dell'LLM (US-12) senza tabelle in\
          più.
        |||
      }
      e: "ID dai CSV, contatori riallineati" {
        class: scheda
        m: |||md
          Gli ID arrivano dai CSV; solo `utente`, `anomalia` e\
          `segnalazione` generano ID da sole. Dopo il seed `setval`\
          sposta i contatori dopo l'ultimo ID caricato. **Perché:**\
          stessi ID tra campione e dataset completo, e backend e batch\
          non creano mai un ID già usato.
        |||
      }
      f: "Funziona su Windows e su Fedora" {
        class: scheda
        m: |||md
          Porte solo su `127.0.0.1`; volumi del repo con `:ro,z` (la\
          `z` serve a SELinux su Fedora, altrove è ignorata; mai `Z`,\
          che bloccherebbe gli altri contenitori). **Perché:** il team\
          usa Docker Desktop su Windows e Podman su Fedora: lo stesso\
          `compose.yaml` deve andare su tutti e due.
        |||
      }
    }

    codice: "Sguardo al codice reale (branch devops/docker-db)" {
      class: area
      grid-rows: 4
      grid-columns: 1
      grid-gap: 20

      k1: "db/migrations/20261116090000_schema_iniziale.sql · utente" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||sql
          CREATE TABLE utente (
            id            integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
            email         text NOT NULL UNIQUE,
            password_hash text NOT NULL,
            ruolo         text NOT NULL CHECK (ruolo IN ('socio', 'operatore', 'admin')),
            socio_id      integer UNIQUE REFERENCES socio (id),
            -- un socio ha sempre il suo socio_id, un dipendente mai
            CHECK ((ruolo = 'socio') = (socio_id IS NOT NULL))
          );
        |||
        n: |||md
          **Nota:** l'ultimo `CHECK` confronta due\
          booleani: o è un socio **e** ha `socio_id`, o\
          non è un socio **e** non ce l'ha. Un operatore\
          collegato per sbaglio a un socio viene\
          rifiutato dal database.
        |||
      }
      k2: "db/migrations/…_schema_iniziale.sql · segnalazione" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||sql
          CREATE TABLE segnalazione (
            id              integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
            socio_id        integer REFERENCES socio (id),     -- null per le interne
            impianto_id     integer REFERENCES impianto (id),  -- in uso, correggibile
            impianto_id_llm integer REFERENCES impianto (id),  -- dall'LLM, mai modificato
            ts              timestamptz NOT NULL DEFAULT now(),
            canale          text NOT NULL CHECK (canale IN ('email', 'portale', 'interno')),
            categoria_llm   text,   -- null = LLM non disponibile
            categoria       text,   -- l'operatore può correggerla
            stato           text NOT NULL DEFAULT 'aperta'
                            CHECK (stato IN ('aperta', 'in_corso', 'chiusa')),
            CHECK (categoria IN ('guasto_impianto', 'bolletta_pagamenti',
              'incentivi_ripartizione', 'adesione_recesso', 'informazioni', 'reclamo'))
          );
        |||
        n: |||md
          **Nota:** un `CHECK` con valore `NULL` passa:\
          per questo una segnalazione senza categoria\
          (LLM giù) è valida, mentre una categoria\
          inventata no. Estratto: urgenze e testo\
          omessi.
        |||
      }
      k3: "db/seed/carica.sql" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||sql
          \copy impianto  FROM '/csv/impianto.csv'  WITH (FORMAT csv, HEADER match)
          \copy socio     FROM '/csv/socio.csv'     WITH (FORMAT csv, HEADER match)
          -- ... 13 tabelle, prima quelle a cui le altre fanno riferimento ...
          \copy ripartizione_mensile FROM '/csv/ripartizione_mensile.csv' WITH (FORMAT csv, HEADER match)

          -- Gli ID sono arrivati dal CSV: i contatori ripartono dopo l'ultimo.
          SELECT setval(pg_get_serial_sequence('segnalazione', 'id'), max(id)) FROM segnalazione;
          SELECT setval(pg_get_serial_sequence('anomalia', 'id'), max(id)) FROM anomalia;
        |||
        n: |||md
          **Nota:** `utente` non si carica da CSV: le\
          password vanno salvate come hash, e l'hash lo\
          fa il backend (`npm run crea-utenti`). Per\
          ricaricare da zero: `docker compose down -v`.
        |||
      }
      k4: "compose.yaml · migrate e seed" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||yaml
          migrate:
            image: ghcr.io/amacneil/dbmate:2.38.1
            command: ["--wait", "--no-dump-schema", "up"]
            volumes:
              - ./db:/repo/db:ro,z   # z: serve solo con SELinux (Fedora)
            depends_on:
              db:
                condition: service_healthy

          seed:
            image: postgres:17
            profiles: ["strumenti"]          # parte solo con: docker compose run --rm seed
            volumes:
              - ./data/${CARTELLA_CSV:-esempi}:/csv:ro,z
            depends_on:
              migrate:
                condition: service_completed_successfully
        |||
        n: |||md
          **Nota:** `CARTELLA_CSV` sceglie quali CSV\
          caricare: `esempi` (campione nel repo) o\
          `output` (dataset completo generato in locale,\
          Sprint 1).
        |||
      }
    }
  }

  # ----------------------------------------------------------------------------
  # BACKEND
  # ----------------------------------------------------------------------------
  backend: {
    grid-columns: 1
    grid-gap: 40

    nav: "" {
      class: griglia
      grid-rows: 1
      grid-gap: 16
      torna: "← Vista generale" {class: torna; link: _}
      llm: "Percorso di una segnalazione →" {class: vai; link: _.layers.flusso_llm}
      pr9: "PR #9 · scheletro backend" {class: vai; link: https://github.com/lufo-336/under-the-sun/pull/9}
      i14: "Issue #14 · area socio" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/14}
      i16: "Issue #16 · segnalazioni" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/16}
    }

    titolo: |||md
      # Backend · Node 22 + Express 5 + pg
      **Stato:** scheletro **unito su `main`** (PR #9 di Stefano, approvata e provata su Windows e Fedora con chiamate HTTP reali). 4 endpoint e 7 test.\
      **Sprint 1 (Stefano):** area socio `/api/me/riepilogo` e `/api/me/consumi` (#14), segnalazioni con LLM e fallback (#16).
    |||

    richiesta: "Il percorso di una richiesta dentro Express" {
      class: area
      direction: down

      in: "Richiesta HTTP\nGET /api/impianti\nAuthorization: Bearer eyJ…" {
        style.fill: "#1E293B"
        style.stroke: "#94A3B8"
        style.border-radius: 8
      }
      json: "express.json({ limit: '100kb' })\nlegge il corpo JSON · x-powered-by spento" {class: fatto}
      router: "Router per prefisso\n/api/salute · /api/auth · /api/impianti" {class: fatto}
      autentica: "autentica(config)\nverifica il JWT (solo HS256)\nmette { id, ruolo, socio_id } in req.utente" {class: fatto}
      ruolo: "richiediRuolo('operatore', 'admin')\nil socio riceve 403" {class: fatto}
      handler: "Gestore della rotta\nquery SQL parametrizzata con pg.Pool" {class: fatto}
      ok: "200 · JSON in snake_case\nnumeri veri, date ISO in UTC" {class: fatto}
      errori: "gestoreErrori (ultimo middleware)\n{ errore: { codice, messaggio } }\n400 · 401 · 403 · 404 · 500" {class: fatto}

      in -> json -> router -> autentica -> ruolo -> handler -> ok: {class: f-fatto}
      autentica -> errori: "401 NON_AUTENTICATO" {class: f-neutra}
      ruolo -> errori: "403 VIETATO" {class: f-neutra}
      router -> errori: "404 NON_TROVATO" {class: f-neutra}
    }

    endpoint: "Gli endpoint di docs/api.md · cosa c'è e cosa manca" {
      class: area
      grid-rows: 1
      grid-columns: 3
      grid-gap: 20

      fatto: "Su main · PR #9\nGET /api/salute · pubblico, usato dal healthcheck\nPOST /api/auth/login · { email, password } → { token, utente }\nGET /api/auth/me · utente riletto dal DB\nGET /api/impianti · solo operatore e admin" {class: fatto}
      s1: "Sprint 1 · Stefano\nGET /api/me/riepilogo?anno= · totali e mesi (#14)\nGET /api/me/consumi?da=&a=&granularita= (#14)\nGET /api/me/segnalazioni · solo le proprie (#16)\nPOST /api/me/segnalazioni · LLM + fallback 201 (#16)" {class: sprint1}
      s2: "Sprint 2\nPOST /api/me/simulazione · calcolo al volo\nGET /api/impianti/:id/produzione · PATCH /api/anomalie/:id\nGET/PATCH /api/segnalazioni · coda per urgenza\nGET /api/comunita/* · /api/soci · /api/verbali" {class: sprint2}
    }

    scelte: "Scelte architetturali e perché" {
      class: area
      grid-rows: 2
      grid-columns: 3
      grid-gap: 20

      a: "App costruita con le dipendenze dall'esterno" {
        class: scheda
        m: |||md
          `creaApp({ db, config })` riceve database e configurazione;\
          `server.js` passa quelli veri, i test un DB finto.\
          **Perché:** `npm test` (7 test, `node:test` + `supertest`)\
          gira in un secondo, anche in CI, senza Postgres acceso.
        |||
      }
      b: "Login che non rivela chi è registrato" {
        class: scheda
        m: |||md
          Email inesistente o password sbagliata danno la **stessa**\
          risposta (`401 CREDENZIALI_ERRATE`), e bcrypt confronta\
          comunque con un hash fittizio. **Perché:** risposte e tempi\
          uguali impediscono di scoprire quali email esistono.
        |||
      }
      c: "JWT stretto all'essenziale" {
        class: scheda
        m: |||md
          Nel token solo `sub`, `ruolo`, `socio_id`; algoritmo fissato\
          a `HS256` sia in firma sia in verifica; scadenza `8h` di\
          default. **Perché:** niente stato di sessione nel server, e\
          niente token accettati con algoritmi diversi.
        |||
      }
      d: "Configurazione che si ferma subito" {
        class: scheda
        m: |||md
          `config.js` legge l'ambiente: se mancano `DATABASE_URL` o\
          `JWT_SECRET` il server non parte e dice cosa copiare.\
          **Perché:** l'errore si vede all'avvio, non al primo login\
          della demo.
        |||
      }
      e: "Numeri veri nel JSON" {
        class: scheda
        m: |||md
          `pg` restituisce i `numeric` come stringhe;\
          `setTypeParser(NUMERIC, Number)` li trasforma in numeri.\
          **Perché:** il contratto vuole `incentivo_eur: 97.55`, non\
          `"97.55"`, e il frontend non deve convertire.
        |||
      }
      f: "Contenitore piccolo e sicuro" {
        class: scheda
        m: |||md
          `node:22-alpine`, prima `package.json` e `npm ci --omit=dev`\
          (strato riusato se cambia solo il codice), utente non-root\
          `USER node`; su `SIGTERM` chiude server e pool in ordine.\
          **Perché:** build veloci, meno superficie d'attacco, nessuna\
          connessione lasciata a metà da `docker compose stop`.
        |||
      }
    }

    codice: "Sguardo al codice reale (branch backend/scheletro)" {
      class: area
      grid-rows: 4
      grid-columns: 1
      grid-gap: 20

      k1: "backend/src/auth.js · chi sei e cosa puoi fare" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||js
          // Legge "Authorization: Bearer <token>" e mette l'utente in req.utente.
          export function autentica(config) {
            return (req, res, next) => {
              const [schema, token] = (req.get('authorization') ?? '').split(' ');
              if (schema !== 'Bearer' || !token) {
                return next(nonAutenticato());
              }
              try {
                const dati = jwt.verify(token, config.jwtSegreto, { algorithms: ['HS256'] });
                req.utente = { id: Number(dati.sub), ruolo: dati.ruolo, socio_id: dati.socio_id ?? null };
                next();
              } catch {
                next(nonAutenticato('Token non valido o scaduto'));
              }
            };
          }

          // Da mettere DOPO autentica: richiediRuolo('operatore', 'admin')
          export function richiediRuolo(...ruoli) {
            return (req, res, next) => {
              if (!ruoli.includes(req.utente?.ruolo)) return next(vietato());
              next();
            };
          }
        |||
        n: |||md
          **Nota:** le rotte dell'area socio (Sprint 1)\
          leggeranno `req.utente.socio_id` da qui: è\
          l'unica fonte del "chi sei".
        |||
      }
      k2: "backend/src/routes/auth.js · login" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||js
          // Se l'email non esiste confrontiamo comunque con un hash qualunque:
          // la risposta impiega lo stesso tempo e non rivela le email registrate.
          const HASH_FITTIZIO = bcrypt.hashSync('nessun-utente', 10);

          router.post('/login', async (req, res) => {
            const { email, password } = req.body ?? {};
            if (typeof email !== 'string' || typeof password !== 'string' || !email || !password) {
              throw datiNonValidi('Servono email e password');
            }
            const { rows } = await db.query(
              'SELECT id, email, password_hash, ruolo, socio_id FROM utente WHERE lower(email) = lower($1)',
              [email.trim()],
            );
            const utente = rows[0];
            const passwordGiusta = await bcrypt.compare(password, utente?.password_hash ?? HASH_FITTIZIO);
            if (!utente || !passwordGiusta) {
              throw new ErroreApi(401, 'CREDENZIALI_ERRATE', 'Email o password non corrette');
            }
            res.json({ token: firmaToken(utente, config), utente: utentePubblico(utente) });
          });
        |||
        n: |||md
          **Nota:** `$1` è un parametro: il valore\
          viaggia separato dalla query, quindi niente\
          SQL injection. Con Express 5 un `throw` dentro\
          una funzione `async` arriva da solo al gestore\
          degli errori.
        |||
      }
      k3: "backend/src/app.js · l'app senza Postgres dentro" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||js
          // L'app riceve db e config dall'esterno: così i test le passano un database finto
          // e non serve Postgres per farli girare.
          export function creaApp({ db, config }) {
            const app = express();
            app.disable('x-powered-by');
            app.use(express.json({ limit: '100kb' }));

            app.use('/api/salute', rotteSalute({ db }));
            app.use('/api/auth', rotteAuth({ db, config }));
            app.use('/api/impianti', rotteImpianti({ db, config }));

            app.use(percorsoNonTrovato);
            app.use(gestoreErrori);
            return app;
          }
        |||
        n: |||md
          **Nota:** nello Sprint 1 si aggiungono qui\
          `app.use('/api/me', ...)` per #14 e #16,\
          sempre prima di `percorsoNonTrovato`.
        |||
      }
      k4: "backend/src/routes/impianti.js · primo endpoint vero" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||js
          router.use(autentica(config), richiediRuolo('operatore', 'admin'));

          router.get('/', async (req, res) => {
            const { rows } = await db.query(`
              SELECT i.id, i.nome, i.comune, i.lat, i.lon, i.kwp,
                     to_char(i.data_attivazione, 'YYYY-MM-DD') AS data_attivazione,
                     count(a.id)::int AS anomalie_aperte
              FROM impianto i
              LEFT JOIN anomalia a ON a.impianto_id = i.id AND a.stato = 'aperta'
              GROUP BY i.id
              ORDER BY i.id`);
            res.json(rows);
          });
        |||
        n: |||md
          **Nota:** `to_char` restituisce già la data\
          come `YYYY-MM-DD` (formato del contratto) e\
          `::int` evita che il conteggio arrivi come\
          stringa.
        |||
      }
    }
  }

  # ----------------------------------------------------------------------------
  # PERCORSO DI UNA SEGNALAZIONE (US-05, poi US-08 e US-12)
  # ----------------------------------------------------------------------------
  flusso_llm: {
    grid-columns: 1
    grid-gap: 40

    nav: "" {
      class: griglia
      grid-rows: 1
      grid-gap: 16
      torna: "← Vista generale" {class: torna; link: _}
      be: "Pagina backend →" {class: vai; link: _.layers.backend}
      i16: "Issue #16 · backend" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/16}
      i17: "Issue #17 · frontend" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/17}
      i19: "Issue #19 · prompt e segnalazioni" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/19}
    }

    titolo: |||md
      # Percorso di una segnalazione · LLM con piano di riserva
      **Stato:** tabella e contratto pronti (PR #6, `docs/api.md`); il codice del backend e della pagina **si scrive nello Sprint 1** (#16 Stefano, #17\
      Mirko); il prompt lo prepara il team dati (#19). La coda dell'operatore è dello Sprint 2 (US-08).
    |||

    sequenza: "Sequenza · gialle = Sprint 1, grigie = Sprint 2" {
      class: area
      shape: sequence_diagram

      socio: "Socio" {style.fill: "#1E293B"; style.stroke: "#94A3B8"}
      fe: "Frontend\npagina segnalazioni" {style.fill: "#0B2433"; style.stroke: "#38BDF8"}
      be: "Backend\n/api/me/segnalazioni" {style.fill: "#2E2309"; style.stroke: "#FBBF24"}
      llm: "LLM\n(piano gratuito)" {style.fill: "#2A1A0E"; style.stroke: "#FB923C"}
      pg: "PostgreSQL\nsegnalazione" {style.fill: "#0E2A1E"; style.stroke: "#34D399"}
      op: "Operatore" {style.fill: "#1E293B"; style.stroke: "#94A3B8"}
      td: "Team dati" {style.fill: "#1E293B"; style.stroke: "#94A3B8"}

      socio -> fe: "scrive solo il testo" {class: f-sprint1}
      fe -> be: "POST { testo } + JWT" {class: f-sprint1}
      be -> llm: "testo, categorie, urgenze, impianti" {class: f-sprint1}

      risponde: "Caso 1 · l'LLM risponde" {
        llm -> be: "categoria, urgenza, impianto" {class: f-sprint1}
        be -> pg: "INSERT *_llm + valori in uso" {class: f-sprint1}
      }
      giu: "Caso 2 · timeout, errore o quota finita" {
        be -> pg: "INSERT con valori NULL" {class: f-sprint1}
      }

      be -> fe: "201 Created (sempre)" {class: f-sprint1}
      fe -> socio: "storico · 'Da classificare'" {class: f-sprint1}
      op -> pg: "Sprint 2 · PATCH corregge" {class: f-sprint2}
      td -> pg: "Sprint 2 · accuratezza (US-12)" {class: f-sprint2}
    }

    scelte: "Scelte architetturali e perché (punto 5 del SAL 1, opzione A)" {
      class: area
      grid-rows: 2
      grid-columns: 2
      grid-gap: 20

      a: "Il socio scrive, l'LLM indovina l'impianto" {
        class: scheda
        m: |||md
          Niente menu degli impianti per il socio: una famiglia non\
          conosce i nomi tecnici e sceglierebbe a caso. L'LLM propone\
          l'impianto, il backend controlla che esista. **Perché:**\
          meno errori silenziosi; l'operatore può sempre correggere.
        |||
      }
      b: "Mai perdere una segnalazione" {
        class: scheda
        m: |||md
          Timeout, errore o quota finita: il backend salva comunque e\
          risponde `201`. La pagina mostra "Da classificare".\
          **Perché:** col piano gratuito l'LLM può mancare proprio\
          durante la demo.
        |||
      }
      c: "Chiave e chiamata solo nel backend" {
        class: scheda
        m: |||md
          Il browser non vede mai la chiave dell'LLM; in sviluppo e in\
          CI si usa un provider finto configurabile. **Perché:** una\
          chiave nel frontend è pubblica; e la CI non deve dipendere\
          da un servizio esterno.
        |||
      }
      d: "Valori LLM congelati, valori in uso correggibili" {
        class: scheda
        m: |||md
          `categoria_llm`, `urgenza_llm`, `impianto_id_llm` non\
          cambiano mai; l'operatore corregge `categoria`, `urgenza`,\
          `impianto_id`. **Perché:** a fine progetto il team dati\
          misura "x % di categorie giuste" (US-12) con una semplice\
          query.
        |||
      }
    }

    codice: "Il contratto già fissato (il codice arriva con #16 e #17)" {
      class: area
      grid-rows: 2
      grid-columns: 1
      grid-gap: 20

      k1: "docs/api.md · POST /api/me/segnalazioni" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||json
          // richiesta
          { "testo": "Da ieri l'app non mostra più i consumi di marzo", "impianto_id": null }

          // risposta 201
          {
            "id": 318, "ts": "2026-11-06T15:02:11Z", "canale": "portale",
            "testo": "Da ieri l'app non mostra più i consumi di marzo",
            "categoria": "informazioni", "urgenza": "bassa",
            "stato": "aperta", "impianto_id": null
          }
        |||
        n: |||md
          **Nota:** se l'LLM non risponde è sempre\
          `201`, con `categoria` e `urgenza` a `null`.\
          Al socio non si mostrano i campi `*_llm`\
          (Issue #16).
        |||
      }
      k2: "Le categorie ammesse (CHECK nel database)" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||sql
          CHECK (categoria IN ('guasto_impianto', 'bolletta_pagamenti',
                               'incentivi_ripartizione', 'adesione_recesso',
                               'informazioni', 'reclamo'))
          CHECK (urgenza IN ('alta', 'media', 'bassa'))
          CHECK (canale  IN ('email', 'portale', 'interno'))
        |||
        n: |||md
          **Nota:** il prompt del team dati (#19) deve\
          usare esattamente queste parole: una risposta\
          fuori elenco verrebbe rifiutata dal database.\
          Nel campione ci sono già 15 segnalazioni\
          etichettate di giugno 2026.
        |||
      }
    }
  }

  # ----------------------------------------------------------------------------
  # FRONTEND
  # ----------------------------------------------------------------------------
  frontend: {
    grid-columns: 1
    grid-gap: 40

    nav: "" {
      class: griglia
      grid-rows: 1
      grid-gap: 16
      torna: "← Vista generale" {class: torna; link: _}
      pr5: "PR #5 · wireframe + restyling" {class: vai; link: https://github.com/lufo-336/under-the-sun/pull/5}
      pr23: "PR #23 · login JWT (US-01)" {class: vai; link: https://github.com/lufo-336/under-the-sun/pull/23}
      i12: "Issue #12 · review #5" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/12}
      i13: "Issue #13 · login reale" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/13}
      i15: "Issue #15 · dashboard socio" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/15}
    }

    titolo: |||md
      # Frontend · React 19 + Vite 8 + Tailwind 4 + Recharts 3
      **Stato:** wireframe delle 8 viste con restyling già integrato nella **PR #5** (commit `d5c537e`); PR #4 e #7 chiuse perché già dentro #5.\
      Mirko ha anche aperto la **PR #23** (`frontend/login-jwt`, US-01) sopra la #5: entrambe aspettano la review (`package-lock.json`, contratto e login).\
      **Sprint 1 (Mirko):** approvare e unire #5 (#12) e #23 (#13), dashboard socio con dati veri (#15), segnalazioni (#17).
    |||

    struttura: "Struttura dell'app · da dove arrivano i dati" {
      class: area
      direction: down

      main: "main.jsx → App.jsx\nBrowserRouter · routesConfig\nogni rotta dentro AppLayout(role, navItems)" {class: revisione}

      viste: "Le 8 viste per ruolo" {
        class: sottoarea
        grid-columns: 4
        grid-gap: 16
        login: "Pubblica\n/login" {class: revisione}
        socio: "Socio\n/socio/dashboard\n/socio/simulatore\n/socio/segnalazioni" {class: revisione}
        op: "Operatore\n/operatore/impianti\n/operatore/segnalazioni" {class: revisione}
        admin: "Admin\n/admin/kpi\n/admin/assemblee" {class: revisione}
      }

      comp: "Componenti condivisi\nKpiCard · Panel · SidebarNav\nStatusBadge · UrgencyBadge · DemoRoleSwitcher" {class: revisione}

      mock: "Oggi · mocks/mockData.js\ndati finti con la forma di docs/api.md" {class: revisione}
      client: "In revisione · PR #23 (#13)\nservices/apiClient.js + proxy /api\nlegge { errore: { codice, messaggio } }" {class: revisione}

      api: "Backend /api\n(vedi pagina backend)" {
        class: fatto
        link: _.layers.backend
      }

      protezione: "In revisione · PR #23 (#13)\nrotte protette per ruolo\nsenza token → /login" {class: revisione}

      main -> viste: {class: f-revisione}
      viste -> comp: {class: f-revisione}
      viste -> mock: "oggi" {class: f-revisione}
      viste -> client: "Sprint 1 (#15, #17)" {class: f-sprint1}
      client -> api: "fetch + Bearer JWT" {class: f-sprint1}
      main -> protezione: {class: f-sprint1}
    }

    scelte: "Scelte architetturali e perché" {
      class: area
      grid-rows: 2
      grid-columns: 2
      grid-gap: 20

      a: "Dati finti con la forma di quelli veri" {
        class: scheda
        m: |||md
          `mockData.js` usa id numerici, `score` 0–1, date\
          `YYYY-MM-DD`, le 6 categorie ufficiali, `categoria: null`\
          ("Da classificare") e lo stato `in_corso`. **Perché:** nello\
          Sprint 1 si cambia la sorgente dei dati, non i componenti.
        |||
      }
      b: "Il ruolo nel browser serve solo a navigare" {
        class: scheda
        m: |||md
          Il menu cambia per ruolo, ma chi può leggere cosa lo decide\
          il backend (403). **Perché:** tutto quello che sta nel\
          browser si può modificare; la sicurezza vera è sul server.
        |||
      }
      c: "Ora italiana solo a schermo" {
        class: scheda
        m: |||md
          Le API parlano in UTC; `formatters.js` converte con\
          `Intl.DateTimeFormat` e `timeZone: 'Europe/Rome'`.\
          **Perché:** il cambio dell'ora legale lo gestisce il\
          browser, non il nostro codice.
        |||
      }
      d: "Un solo punto per le chiamate HTTP" {
        class: scheda
        m: |||md
          `apiClient.js` aggiunge `Authorization: Bearer` e il JSON;\
          nello Sprint 1 leggerà gli errori del contratto. Con il\
          proxy `/api` di Vite, frontend e backend sembrano lo stesso\
          sito. **Perché:** niente CORS in sviluppo, niente URL del\
          backend sparsi nelle pagine.
        |||
      }
    }

    codice: "Sguardo al codice reale (branch frontend/wireframe)" {
      class: area
      grid-rows: 4
      grid-columns: 1
      grid-gap: 20

      k1: "frontend/src/App.jsx · rotte per ruolo" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||jsx
          const routesConfig = [
            { path: '/socio/dashboard',        role: 'socio',     element: <SocioDashboardPage /> },
            { path: '/socio/simulatore',       role: 'socio',     element: <SocioSimulatorePage /> },
            { path: '/socio/segnalazioni',     role: 'socio',     element: <SocioSegnalazioniPage /> },
            { path: '/operatore/impianti',     role: 'operatore', element: <OperatoreImpiantiPage /> },
            { path: '/operatore/segnalazioni', role: 'operatore', element: <OperatoreSegnalazioniPage /> },
            { path: '/admin/kpi',              role: 'admin',     element: <AdminKpiPage /> },
            { path: '/admin/assemblee',        role: 'admin',     element: <AdminAssembleePage /> },
            { path: '/', element: <Navigate to="/login" replace /> },
            { path: '*', element: <Navigate to="/login" replace /> }
          ]
        |||
        n: |||md
          **Nota:** oggi `role` sceglie solo il menu\
          laterale. Nello Sprint 1 (#13) lo stesso campo\
          servirà a bloccare le pagine degli altri\
          ruoli.
        |||
      }
      k2: "frontend/src/utils/formatters.js · da UTC a ora italiana" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||js
          export const formatUtcToItalianDate = (isoString, options = {}) => {
            if (!isoString) return '—'

            const date = new Date(isoString)
            if (Number.isNaN(date.getTime())) return '—'

            return new Intl.DateTimeFormat('it-IT', {
              timeZone: 'Europe/Rome',
              ...options
            }).format(date)
          }
        |||
        n: |||md
          **Nota:** `'2026-06-01T11:00:00Z'` diventa\
          `01/06/2026, 13:00`: d'estate l'Italia è a\
          UTC+2.
        |||
      }
      k3: "frontend/src/services/apiClient.js · oggi" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||js
          const API_BASE_URL = '/api'

          async function request(endpoint, { method = 'GET', body, token, headers = {} } = {}) {
            const config = { method, headers: { ...headers } }
            if (token) {
              config.headers.Authorization = `Bearer ${token}`
            }
            // ... corpo JSON ...
            const response = await fetch(`${API_BASE_URL}${endpoint}`, config)
            if (!response.ok) {
              const errorText = await response.text()
              throw new Error(errorText || 'Errore di richiesta API')
            }
            // ...
          }
        |||
        n: |||md
          **Da fare (#13):** al posto del testo grezzo,\
          leggere `{ errore: { codice, messaggio } }` e\
          mostrare `messaggio`; su `401` tornare al\
          login.
        |||
      }
      k4: "frontend/vite.config.js · oggi" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||js
          import react from '@vitejs/plugin-react'
          import tailwindcss from '@tailwindcss/vite'
          import { defineConfig } from 'vite'

          export default defineConfig({
            plugins: [react(), tailwindcss()],
          })
        |||
        n: |||md
          **Da fare (#13):** aggiungere `server.proxy`\
          per inoltrare `/api` al backend su\
          `localhost:3000`, così `fetch('/api/...')`\
          funziona già in `npm run dev`.
        |||
      }
    }
  }

  # ----------------------------------------------------------------------------
  # PIPELINE DATI
  # ----------------------------------------------------------------------------
  dati: {
    grid-columns: 1
    grid-gap: 40

    nav: "" {
      class: griglia
      grid-rows: 1
      grid-gap: 16
      torna: "← Vista generale" {class: torna; link: _}
      pr8: "PR #8 · campione SAL 1" {class: vai; link: https://github.com/lufo-336/under-the-sun/pull/8}
      i18: "Issue #18 · dataset di 2 anni" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/18}
      i19: "Issue #19 · segnalazioni e modelli" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/19}
    }

    titolo: |||md
      # Pipeline dati · Python (pandas, numpy)
      **Stato:** generatore e controlli **uniti su `main`** (PR #8 di Francesco con Giuseppe e Cecilia, approvata da Mirko e Luca): campione di giugno 2026,\
      123 controlli su 123 ok.\
      **Sprint 1 (team dati):** dataset completo di 2 anni (#18); 200-300 segnalazioni etichettate, prompt LLM, primi modelli, formule CER e simulatore\
      (#19).
    |||

    pipeline: "genera.py · un solo programma, due configurazioni" {
      class: area
      direction: down

      fonti: "Fonti reali · scaricate una volta e messe in cache\nOpen-Meteo (meteo orario, geocoding) · PVGIS (resa dei pannelli)\nARERA (consumi tipo) · ISPRA (CO2) · GSE (incentivi)" {
        class: esterno
        shape: cloud
      }

      passi: "I 6 passi, in quest'ordine" {
        class: sottoarea
        grid-rows: 1
        grid-columns: 6
        grid-gap: 40
        p1: "1 · anagrafiche\nsoci e impianti" {class: fatto}
        p2: "2 · meteo\nOpen-Meteo" {class: fatto}
        p3: "3 · PVGIS\nk_impianto" {class: fatto}
        p4: "4 · produzione\noraria" {class: fatto}
        p5: "5 · consumi\norari per socio" {class: fatto}
        p6: "6 · derivate\nbolletta, ripartizione" {class: fatto}
        p1 -> p2 -> p3 -> p4 -> p5 -> p6: {class: f-fatto}
      }

      scrivi: "scrivi_csv()\ncolonne identiche a Postgres · UTF-8 · fine riga LF" {class: fatto}
      controlli: "controlli.py · 123 su 123 ok\nformato · serie complete · integrità ID · valori ammessi\nnumeri del verbale · riproducibilità bit per bit" {class: fatto}

      esempi: "data/esempi/ · nel repo\ncampione giugno 2026\n13 CSV per il DB + 2 di valutazione" {class: fatto}
      output: "data/output/ · esclusa da Git\ndataset completo di 2 anni (#18)" {class: sprint1}
      nlp: "Segnalazioni etichettate e modelli (#19)\n200-300 testi coerenti con le anomalie\nprompt LLM · previsioni · anomalie" {class: sprint1}

      batch: "Sprint 2 · batch offline (US-11)\nleggono le serie dal DB, scrivono previsioni,\nanomalie e ripartizione mensile" {class: sprint2}

      fonti -> passi: {class: f-neutra}
      passi -> scrivi -> controlli: {class: f-fatto}
      controlli -> esempi: "--config piccola" {class: f-fatto}
      controlli -> output: "--config completa" {class: f-sprint1}
      output -> nlp: "coerenti con le anomalie del dataset" {class: f-sprint1}
      nlp -> batch: "modelli pronti" {class: f-sprint2}
    }

    config: "Le due configurazioni (config.py)" {
      class: area
      t: |||md
        | | **piccola** · campione SAL 1 (fatto) | **completa** · dataset SAL 2 (Sprint 1, #18) |
        |---|---|---|
        | Periodo | giugno 2026 · 720 ore | nov 2024 → ott 2026 · 17.520 ore |
        | Impianti | 3 (id 1-3) | 8 |
        | Soci | 20 scelti con una regola fissa | tutti i 240 |
        | Consumi | volumi annui provvisori per tipo di socio | volumi mensili ARERA |
        | Resa PVGIS | `k_impianto = 1` | tarata su PVGIS |
        | Anomalie | solo il guasto fisso del 1° giugno | anche anomalie casuali |
        | Tabelle derivate | valori provvisori nei CSV | le scrive il batch (Sprint 2) |
        | Cartella | `data/esempi/` (nel repo) | `data/output/` (esclusa da Git) |
      |||
    }

    scelte: "Scelte architetturali e perché" {
      class: area
      grid-rows: 2
      grid-columns: 3
      grid-gap: 20

      a: "Un generatore casuale per ogni impianto e socio" {
        class: scheda
        m: |||md
          `default_rng([42, 0, id_impianto])`,\
          `default_rng([42, 1, id_socio])`: ogni entità ha la sua\
          sequenza. **Perché:** passare da 3 a 8 impianti non cambia i\
          numeri dei primi 3; campione e dataset completo restano\
          coerenti.
        |||
      }
      b: "Colonne fissate in un posto solo" {
        class: scheda
        m: |||md
          `config.COLONNE` elenca nome e ordine delle colonne di ogni\
          CSV; `scrivi_csv` si rifiuta di scrivere se non coincidono.\
          **Perché:** è la metà Python del contratto: l'altra metà è\
          `HEADER match` nel seed.
        |||
      }
      c: "Nel repo solo script e campione" {
        class: scheda
        m: |||md
          Il campione (giugno 2026) va su GitHub; i 2 anni si\
          rigenerano identici in `data/output/`, esclusa da Git.\
          **Perché:** repo leggero, e nessun dubbio su quale versione\
          del dataset sia quella giusta.
        |||
      }
      d: "Una storia coerente per la demo" {
        class: scheda
        m: |||md
          Il 1° giugno 2026 l'impianto *Tetto scuola Pinerolo* si\
          ferma (inverter in protezione): c'è l'anomalia, ci sono le\
          segnalazioni dei soci e il verbale dell'assemblea di luglio\
          ne parla. **Perché:** l'operatore può "collegare i puntini"\
          tra anomalia, segnalazioni e verbale.
        |||
      }
      e: "Fonti dichiarate file per file" {
        class: scheda
        m: |||md
          `data/data-dictionary.md` v1 dice per ogni file se è reale\
          (meteo da Open-Meteo), calcolato da dati reali (produzione,\
          controllata con PVGIS) o sintetico (consumi, testi), con\
          licenze e fonti. **Perché:** al cliente si può spiegare da\
          dove viene ogni numero.
        |||
      }
      f: "Energia condivisa calcolata ora per ora" {
        class: scheda
        m: |||md
          Modello CER realistico: ogni ora\
          `condivisa = min(immessa, prelevata)`, divisa tra i soci in\
          proporzione ai loro prelievi in quell'ora. **Perché:** è la\
          regola del GSE; chi consuma quando c'è il sole riceve più\
          incentivo.
        |||
      }
    }

    codice: "Sguardo al codice reale (branch dati/campione-sal1)" {
      class: area
      grid-rows: 4
      grid-columns: 1
      grid-gap: 20

      k1: "data/generazione/derivate.py · ripartizione dell'incentivo" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||python
          immessi = produzione_oraria.groupby("ts")["kwh"].sum()

          # Un socio conta dalle 00:00 UTC del giorno di adesione
          c = consumo_orario.merge(socio[["id", "data_adesione"]], left_on="socio_id", right_on="id")
          c = c[c["ts"] >= c["data_adesione"] + "T00:00:00Z"].copy()
          prelevati = c.groupby("ts")["kwh"].sum()
          condivisi = np.minimum(immessi.reindex(prelevati.index, fill_value=0.0), prelevati)
          frazione = (condivisi / prelevati).where(prelevati > 0, 0.0)
          c["quota"] = c["kwh"] * c["ts"].map(frazione)

          df = c.assign(mese=_mese(c["ts"])).groupby(["socio_id", "mese"], as_index=False)["quota"].sum()
          df["incentivo_eur"] = (df["kwh_condivisi"] * (p["tariffa_premio_eur_kwh"]
                                 + p["valorizzazione_arera_eur_kwh"])).round(2)
          df["co2_evitata_kg"] = (df["kwh_condivisi"] * p["fattore_co2_kg_kwh"]).round(3)
        |||
        n: |||md
          **Nota:** estratto (arrotondamenti omessi). Le\
          tariffe e il fattore CO2 non sono nel codice:\
          arrivano dalla tabella `parametro`, con la\
          fonte accanto. La formula definitiva è un\
          compito di #19.
        |||
      }
      k2: "data/generazione/config.py · seed per entità" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||python
          SEED = 42

          def rng_impianto(impianto_id: int) -> np.random.Generator:
              """Generatore casuale proprio di un impianto: default_rng([42, 0, id])."""
              return np.random.default_rng([SEED, 0, impianto_id])

          def rng_socio(socio_id: int) -> np.random.Generator:
              """Generatore casuale proprio di un socio: default_rng([42, 1, id])."""
              return np.random.default_rng([SEED, 1, socio_id])
        |||
        n: |||md
          **Nota:** con un solo generatore per tutto,\
          aggiungere un impianto sposterebbe tutti i\
          numeri casuali che vengono dopo.
        |||
      }
      k3: "data/generazione/genera.py · scrivi_csv" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||python
          def scrivi_csv(df: pd.DataFrame, nome: str, cartella: Path) -> Path:
              """UTF-8 senza BOM, fine riga \n su ogni sistema, colonne come nel §4."""
              attese = config.COLONNE[nome]
              if list(df.columns) != attese:
                  raise ValueError(f"{nome}: colonne {list(df.columns)}, attese {attese}")
              cartella.mkdir(parents=True, exist_ok=True)
              percorso = cartella / f"{nome}.csv"
              df.to_csv(percorso, index=False, encoding="utf-8", lineterminator="\n", na_rep="")
              return percorso
        |||
        n: |||md
          **Nota:** con `lineterminator="\n"` lo stesso\
          CSV ha lo stesso hash su Windows, macOS e\
          Linux: è così che `controlli.py` verifica la\
          riproducibilità.
        |||
      }
      k4: "data/generazione/config.py · le due configurazioni" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||python
          "completa": {
              "descrizione": "Dataset SAL 2: nov 2024 - ott 2026, 8 impianti, 240 soci",
              "primo_ts": "2024-11-01T00:00:00Z",
              "ultimo_ts": "2026-10-31T23:00:00Z",  # 17.520 ore
              "impianti": [1, 2, 3, 4, 5, 6, 7, 8],
              "soci": "tutti",
              "volumi_consumo": "arera",
              "taratura_pvgis": True,
              "anomalie_casuali": True,
              "tabelle_provvisorie": False,  # nel dataset completo le scrivono i batch
              "cartella": CARTELLA_OUTPUT,
          },
        |||
        n: |||md
          **Nota:** è il lavoro di #18: la\
          configurazione esiste già, va completata e\
          fatta passare da tutti i controlli.
        |||
      }
    }
  }

  # ----------------------------------------------------------------------------
  # CI, DEVOPS E PROCESSO GIT
  # ----------------------------------------------------------------------------
  devops: {
    grid-columns: 1
    grid-gap: 40

    nav: "" {
      class: griglia
      grid-rows: 1
      grid-gap: 16
      torna: "← Vista generale" {class: torna; link: _}
      s1: "Piano Sprint 1 →" {class: vai; link: _.layers.sprint1}
      hist: "Storico GitHub →" {class: vai; link: _.layers.storico}
      pr10: "PR #10 · CI" {class: vai; link: https://github.com/lufo-336/under-the-sun/pull/10}
      i11: "Issue #11 · merge e check" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/11}
      i20: "Issue #20 · Compose e giro di prova" {class: vai; link: https://github.com/lufo-336/under-the-sun/issues/20}
    }

    titolo: |||md
      # CI, DevOps e processo di lavoro
      **Stato:** #6, #8 e #9 già **unite su `main`**; CI di base scritta (PR #10 di Luca, 3 job su 3 verdi, review chiesta a Geoffrey, Stefano e Mirko).\
      Ruleset `protezione-main` attivo: PR obbligatoria con 1 approvazione, niente force-push.\
      **Sprint 1:** unire #10 e attivare i check CI obbligatori su `main` (#11, Luca); servizio `frontend` in Compose e giro di prova a mano su ogni PR\
      (#20, Geoffrey).
    |||

    flusso: "Il giro di una modifica" {
      class: area
      direction: right

      branch: "Branch di lavoro\nbackend/…, frontend/…\ndati/…, devops/…" {class: fatto}
      pr: "Pull Request\nrevisore indicato\nall'apertura" {class: fatto}
      ci: "CI · 3 job\nautomatici" {class: revisione}
      review: "Review + giro di prova\n1 Approve obbligatoria\nprova manuale (#20)" {class: sprint1}
      main: "main\nprotezione-main\ncheck CI obbligatori (#11)" {class: sprint1}

      branch -> pr -> ci -> review -> main: {class: f-neutra}
    }

    jobs: "I 3 job di .github/workflows/ci.yml · ognuno salta se la sua cartella non esiste ancora" {
      class: area
      grid-rows: 1
      grid-columns: 3
      grid-gap: 20

      j1: "Backend (test)\nNode 22 · npm ci\nlint (se c'è) · npm test → 7 test" {class: revisione}
      j2: "Frontend (lint e build)\nNode 22 · npm ci\noxlint · vite build" {class: revisione}
      j3: "Database, seed e Compose\ncp .env.example .env · up --build --wait backend\nseed 13 CSV · crea-utenti · curl /api/salute\nlog se fallisce · down -v alla fine" {class: revisione}
    }

    merge: "Ordine di merge su main (#11) · #6, #8, #9 già unite" {
      class: area
      direction: right

      pr6: "PR #6\ndatabase in Docker\nunita su main" {
        class: fatto
        link: https://github.com/lufo-336/under-the-sun/pull/6
      }
      pr8: "PR #8\ncampione dati\nunita su main" {
        class: fatto
        link: https://github.com/lufo-336/under-the-sun/pull/8
      }
      pr9: "PR #9\nscheletro backend\nunita su main" {
        class: fatto
        link: https://github.com/lufo-336/under-the-sun/pull/9
      }
      pr10: "PR #10\nCI di base\nattende l'Approve" {
        class: revisione
        link: https://github.com/lufo-336/under-the-sun/pull/10
      }
      check: "Check CI\nobbligatori\nsu main" {class: sprint1}

      pr6 -> pr8 -> pr9: {class: f-fatto}
      pr9 -> pr10: {class: f-revisione}
      pr10 -> check: {class: f-sprint1}
    }

    compose: "Servizi di compose.yaml" {
      class: area
      grid-rows: 1
      grid-columns: 6
      grid-gap: 16

      db: "db\npostgres:17" {class: fatto; shape: cylinder}
      migrate: "migrate\ndbmate" {class: fatto}
      seed: "seed\na richiesta" {class: fatto}
      backend: "backend\nNode 22" {class: fatto}
      frontend: "frontend\nSprint 1 (#20)" {class: sprint1}
      batch: "batch Python\nSprint 2" {class: sprint2}
    }

    scelte: "Scelte architetturali e perché" {
      class: area
      grid-rows: 2
      grid-columns: 2
      grid-gap: 20

      a: "La CI prova il contratto, non solo il codice" {
        class: scheda
        m: |||md
          Il job *integrazione* avvia Postgres, applica le migrazioni\
          e carica i CSV veri del team dati. **Perché:** se una PR\
          rompe l'allineamento schema ↔ CSV diventa rossa subito, non\
          alla demo.
        |||
      }
      b: "Job che si adattano al branch" {
        class: scheda
        m: |||md
          Ogni job controlla prima se `backend/`, `frontend/` o\
          `compose.yaml` esistono; se no salta e resta verde.\
          **Perché:** la stessa CI funziona mentre le prime PR entrano\
          una alla volta.
        |||
      }
      c: "Permessi minimi e corse inutili fermate" {
        class: scheda
        m: |||md
          `permissions: contents: read`; `concurrency` ferma la corsa\
          vecchia quando arriva un nuovo commit sulla stessa PR (mai\
          su `main`). **Perché:** meno rischi e meno minuti di Actions\
          sprecati.
        |||
      }
      d: "La CI non sostituisce la prova umana" {
        class: scheda
        m: |||md
          Geoffrey fa il giro manuale (login, dashboard, segnalazione)\
          prima dei merge delle PR di US-01, 02 e 05. **Perché:** i\
          test non vedono una pagina storta o un flusso scomodo.
        |||
      }
    }

    codice: "Sguardo al codice reale (branch devops/ci)" {
      class: area
      grid-rows: 2
      grid-columns: 1
      grid-gap: 20

      k1: ".github/workflows/ci.yml · il controllo 'esiste già?'" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||yaml
          - name: Controlla quali servizi e dati esistono
            id: presente
            run: |
              echo "compose=$(test -f compose.yaml && test -f .env.example && echo true || echo false)" >> "$GITHUB_OUTPUT"
              echo "csv=$(test -f data/esempi/impianto.csv && echo true || echo false)" >> "$GITHUB_OUTPUT"
              echo "backend=$(test -f backend/Dockerfile && echo true || echo false)" >> "$GITHUB_OUTPUT"

          - name: Avvia stack completo (database, migrazioni e backend)
            if: steps.presente.outputs.compose == 'true' && steps.presente.outputs.backend == 'true'
            run: docker compose up -d --build --wait backend
        |||
        n: |||md
          **Nota:** `--wait` aspetta che il backend sia\
          *healthy*; si avvia il solo `backend` perché\
          `--wait` non va d'accordo con `migrate`, che\
          per natura si spegne.
        |||
      }
      k2: ".github/workflows/ci.yml · seed e prova finale" {
        class: scheda
        grid-rows: 1
        grid-columns: 2
        grid-gap: 24
        c: |||yaml
          - name: Carica i CSV di esempio (controllo contratto schema <-> dati)
            if: steps.presente.outputs.compose == 'true' && steps.presente.outputs.csv == 'true'
            run: docker compose run --rm seed

          - name: Crea account di prova e verifica /api/salute
            if: steps.presente.outputs.compose == 'true' && steps.presente.outputs.backend == 'true'
            run: |
              docker compose exec -T backend npm run crea-utenti
              curl --fail --silent --show-error --retry 5 --retry-delay 2 --retry-all-errors \
                http://127.0.0.1:3000/api/salute

          - name: Pulizia container e volumi
            if: always() && steps.presente.outputs.compose == 'true'
            run: docker compose down -v
        |||
        n: |||md
          **Nota:** `if: always()` fa la pulizia anche\
          quando un passo prima è fallito.
        |||
      }
    }
  }

